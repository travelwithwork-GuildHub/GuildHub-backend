DATABASE_URL=postgresql://guildhub:guildhub@localhost:5432/guildhub

# 測試專用的庫。測試會 drop schema，所以刻意跟 DATABASE_URL 分開，而且沒設
# 的時候測試是 skip 不是退回 DATABASE_URL —— 退回等於每跑一次測試就清空開發資料。
#
#   docker exec guildhub-db psql -U guildhub -d postgres -c "create database guildhub_test owner guildhub;"
TEST_DATABASE_URL=postgresql://guildhub:guildhub@localhost:5432/guildhub_test
SESSION_SECRET=change-me
ROOM_TOKEN_SECRET=change-me

# 允許帶 cookie 跨源的前端來源，逗號分隔。不接受 *（帶憑證時瀏覽器不收萬用字元）。
# 3100／3101 是 GuildHub-frontend 的 next dev／next start。
# 前後端同源部署（deploy/README.md 的 Caddy 分流）時留空：`CORS_ORIGINS=`。
# 前端在另一個網域時才填正式網域，並且要開下面的 COOKIE_CROSS_SITE。
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3100,http://localhost:3101

# 前端部署在另一個網域時（Vercel／GitHub Pages）必須設成 true，否則 session
# cookie 跨不過去，症狀是「登入成功，然後每個 API 都 401」。
# 設 true 的前提是後端有 HTTPS —— SameSite=None 必須搭配 Secure。
# CORS_ORIGINS 出現非本機來源但這裡沒開，啟動時會直接炸掉。
COOKIE_CROSS_SITE=false
